{
  "name": "speed-reader",
  "version": "1.6",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=1.22.22"
  },
  "scripts": {
    "start": "vite --open /src/test/test.html",
    "start-settings": "vite --open /src/settings/settings.html",
    "test": "vitest run",
    "build": "yarn test && node build.ts",
    "package": "rm -rf build && yarn build && zip -r extension.zip build icons manifest.json",
    "fmt": "dprint fmt"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "dprint": "^0.57.4",
    "less": "^4.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {}
}
